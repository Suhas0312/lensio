generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
  OPTICIAN
}

enum FrameShape {
  RECTANGLE
  ROUND
  CAT_EYE
  AVIATOR
  WAYFARER
  SQUARE
  OVAL
  GEOMETRIC
}

enum FrameMaterial {
  ACETATE
  METAL
  TITANIUM
  TR90
  MIXED
}

enum FrameSize {
  SMALL
  MEDIUM
  WIDE
}

enum Gender {
  MEN
  WOMEN
  UNISEX
  KIDS
}

enum LensType {
  SINGLE_VISION_DISTANCE
  SINGLE_VISION_READING
  BIFOCAL
  PROGRESSIVE
  ZERO_POWER
}

enum PrescriptionSource {
  UPLOAD
  MANUAL
  SEND_LATER
}

enum PrescriptionStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum OrderStatus {
  PAYMENT_PENDING
  PLACED
  PRESCRIPTION_VERIFIED
  LENS_CUTTING_FITTING
  QUALITY_CHECK
  DISPATCHED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  COD
  UPI_MANUAL // customer pays the shop's UPI ID / QR directly; admin confirms
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  COD_PENDING
  COD_COLLECTED
  SUBMITTED // manual UPI: customer entered a UTR, waiting for admin to confirm
}

model User {
  id            String         @id @default(cuid())
  phone         String?        @unique // the customer's mobile number (given to the delivery agent)
  phoneVerified Boolean        @default(false) // confirmed with a WhatsApp/SMS code
  name          String?
  email         String? // lower-case; uniqueness enforced in code (safe to add to an existing database)
  passwordHash  String?
  role          Role           @default(CUSTOMER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  addresses     Address[]
  prescriptions Prescription[]
  cartItems     CartItem[]
  orders        Order[]
  couponUses    CouponUse[]
  wishlist      WishlistItem[]
  reviews       Review[]
  pointsLedger  PointsEntry[]
  pointsBalance Int            @default(0) // denormalised for fast reads; PointsEntry is the source of truth
  giftCards     GiftCardRedemption[]
  eyeTestRequests EyeTestRequest[]

  @@index([email])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String? // SMS codes (future)
  email     String? // email codes
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, createdAt])
  @@index([email, createdAt])
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String
  altPhone  String? // optional second number for the delivery agent
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  isDefault Boolean  @default(false)
  archived  Boolean  @default(false) // edited/deleted but kept for past orders
  createdAt DateTime @default(now())
  orders    Order[]
}

model Product {
  id           String         @id @default(cuid())
  slug         String         @unique
  name         String
  brand        String         @default("Lensio")
  description  String
  shape        FrameShape
  material     FrameMaterial
  gender       Gender
  isSunglasses Boolean        @default(false)
  basePrice    Int // paise, frame only
  mrp          Int // paise
  lensWidthMm  Int
  bridgeMm     Int
  templeMm     Int
  frameWidthMm Int
  weightGrams  Int?
  tryOnImage   String? // transparent PNG, front view, used for try-on overlay
  tryOn3d      Json?   // 3D try-on: { url: GLB/glTF link, scale, offsetY, offsetZ, rotX } (optional calibration)
  instagramPostUrl String? // the Instagram post this frame came from (shown as "View on Instagram")
  isActive     Boolean        @default(true)
  rating       Float          @default(0)
  ratingCount  Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  variants     FrameVariant[]
  images       ProductImage[]
  wishlistedBy WishlistItem[]
  reviews      Review[]

  @@index([shape, material, gender, isActive])
}

model FrameVariant {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku        String      @unique
  colorName  String
  colorHex   String
  size       FrameSize
  stock      Int         @default(0)
  priceDelta Int         @default(0)
  cartItems  CartItem[]
  orderItems OrderItem[]
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model WishlistItem {
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

/// A lens package = lens type + material/index tier, e.g. "Progressive 1.60 Premium".
model LensPackage {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  lensType    LensType
  index       Decimal     @db.Decimal(3, 2)
  description String
  price       Int // paise
  maxAbsSph   Decimal     @db.Decimal(4, 2) // highest |SPH| this package supports
  maxAbsCyl   Decimal     @db.Decimal(4, 2)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

model Coating {
  id          String   @id @default(cuid())
  code        String   @unique // BLUE_CUT, ARC, HYDROPHOBIC, PHOTOCHROMIC
  name        String
  description String
  price       Int
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
}

model Prescription {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  label         String             @default("My prescription")
  patientName   String?
  source        PrescriptionSource
  imageKey      String?
  // Right eye (OD)
  odSph         Decimal?           @db.Decimal(5, 2)
  odCyl         Decimal?           @db.Decimal(5, 2)
  odAxis        Int?
  odAdd         Decimal?           @db.Decimal(4, 2)
  odNear        Decimal?           @db.Decimal(5, 2) // near-vision (N.V.) SPH, if the prescription has one
  // Left eye (OS)
  osSph         Decimal?           @db.Decimal(5, 2)
  osCyl         Decimal?           @db.Decimal(5, 2)
  osAxis        Int?
  osAdd         Decimal?           @db.Decimal(4, 2)
  osNear        Decimal?           @db.Decimal(5, 2)
  pdTotal       Decimal?           @db.Decimal(4, 1)
  pdRight       Decimal?           @db.Decimal(4, 1)
  pdLeft        Decimal?           @db.Decimal(4, 1)
  isHighPower   Boolean            @default(false)
  status        PrescriptionStatus @default(PENDING_REVIEW)
  reviewNote    String?
  reviewedById  String?
  reviewedAt    DateTime?
  prescribedOn  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  cartItems     CartItem[]
  orderItems    OrderItem[]
}

model CartItem {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId      String
  variant        FrameVariant  @relation(fields: [variantId], references: [id])
  lensPackageId  String?
  lensPackage    LensPackage?  @relation(fields: [lensPackageId], references: [id])
  coatingCodes   String[]
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  sendRxLater    Boolean       @default(false)
  quantity       Int           @default(1)
  createdAt      DateTime      @default(now())
}

model Order {
  id                String             @id @default(cuid())
  orderNumber       String             @unique
  userId            String
  user              User               @relation(fields: [userId], references: [id])
  addressId         String
  address           Address            @relation(fields: [addressId], references: [id])
  shippingSnapshot  Json
  status            OrderStatus        @default(PAYMENT_PENDING)
  paymentMethod     PaymentMethod
  subtotal          Int
  discount          Int                @default(0)
  shippingFee       Int                @default(0)
  codFee            Int                @default(0)
  total             Int
  couponCode        String?
  needsPrescription Boolean            @default(false)
  holdExpiresAt     DateTime?
  awbCode           String?
  courierName       String?
  shiprocketOrderId String?
  trackingUrl       String?
  cancelReason      String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  items             OrderItem[]
  payments          Payment[]
  events            OrderStatusEvent[]
  tracking          TrackingUpdate[]
  reviews           Review[]
  pointsEntries     PointsEntry[]
  giftCardRedemptions GiftCardRedemption[]
  giftCardUsed      Int                @default(0) // paise covered by a gift card on this order
  pointsUsed        Int                @default(0) // paise covered by loyalty points on this order
  pointsEarned      Int                @default(0) // points credited once this order is delivered
  reviewRequestedAt DateTime? // when the "please review" email was sent
  paymentReminderAt DateTime? // when we last reminded the customer to finish paying

  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
}

model OrderItem {
  id             String        @id @default(cuid())
  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        FrameVariant  @relation(fields: [variantId], references: [id])
  lensPackageId  String?
  lensPackage    LensPackage?  @relation(fields: [lensPackageId], references: [id])
  prescriptionId String?
  prescription   Prescription? @relation(fields: [prescriptionId], references: [id])
  coatingCodes   String[]
  productName    String
  variantLabel   String
  framePrice     Int
  lensPrice      Int
  coatingPrice   Int
  unitPrice      Int
  quantity       Int
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod
  status            PaymentStatus
  amount            Int
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  failureReason     String?
  utr               String? // UPI reference number entered by the customer
  proofKey          String? // optional payment screenshot (private file)
  raw               Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())
}

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  description     String
  percentOff      Int? // 1..100
  flatOff         Int? // paise
  maxDiscount     Int? // paise cap for percent coupons
  minOrderValue   Int         @default(0)
  firstOrderOnly  Boolean     @default(false)
  requiresLens    Boolean     @default(false) // e.g. "frame + lens combo"
  usageLimit      Int?
  perUserLimit    Int         @default(1)
  validFrom       DateTime    @default(now())
  validTo         DateTime?
  isActive        Boolean     @default(true)
  uses            CouponUse[]
}

model CouponUse {
  id        String   @id @default(cuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  orderId   String   @unique
  createdAt DateTime @default(now())
}

model WebhookEvent {
  id         String   @id // provider event id, for idempotency
  provider   String
  type       String
  receivedAt DateTime @default(now())
}

/// Shop settings editable from the admin panel (UPI ID, QR image, COD on/off).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Courier / shop updates shown on the customer's live tracking screen.
model TrackingUpdate {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  message   String
  location  String?
  source    String   @default("shop") // shop | courier
  at        DateTime @default(now())

  @@index([orderId, at])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A customer review of a product, optionally tied to the order that makes it a verified purchase.
model Review {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id])
  rating      Int          // 1-5
  title       String?
  body        String
  photos      String[]     @default([])
  status      ReviewStatus @default(PENDING)
  moderatorNote String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([productId, orderId]) // one review per product per order
  @@index([productId, status])
}

enum PointsReason {
  EARNED_DELIVERY
  REDEEMED_CHECKOUT
  REFUNDED_CANCEL
  ADMIN_ADJUST
}

/// Ledger of every loyalty-point change. User.pointsBalance is kept in sync alongside it.
model PointsEntry {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  points    Int          // positive = credit, negative = debit
  reason    PointsReason
  note      String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
}

/// A gift card / store credit code. Can be sold to a customer or issued free by the shop.
model GiftCard {
  id            String               @id @default(cuid())
  code          String               @unique
  initialValue  Int                  // paise
  balance       Int                  // paise remaining
  purchaserName String?
  purchaserEmail String?
  recipientEmail String?
  message       String?
  isActive      Boolean              @default(true)
  expiresAt     DateTime?
  createdAt     DateTime             @default(now())
  redemptions   GiftCardRedemption[]
}

/// One use of a gift card against one order (a card can be used across several orders until empty).
model GiftCardRedemption {
  id         String   @id @default(cuid())
  giftCardId String
  giftCard   GiftCard @relation(fields: [giftCardId], references: [id])
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  amount     Int      // paise deducted from the card for this order
  createdAt  DateTime @default(now())

  @@index([giftCardId])
  @@index([orderId])
}

/// A physical store location, shown on the in-app store locator.
model Store {
  id          String   @id @default(cuid())
  name        String
  addressLine String
  city        String
  state       String
  pincode     String
  phone       String?
  latitude    Float?
  longitude   Float?
  hours       String?  // free text, e.g. "Mon-Sat 10am-8pm, Sun 11am-6pm"
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EyeTestStatus {
  REQUESTED
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// A customer's request for a home eye-test visit. The shop calls to confirm and schedule.
model EyeTestRequest {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  addressLine  String
  city         String
  pincode      String
  preferredDate DateTime
  preferredSlot String       // e.g. "Morning (9am-12pm)"
  notes        String?
  status       EyeTestStatus @default(REQUESTED)
  scheduledFor DateTime?
  staffNote    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
}

/// Automatic translations of app text into Indian languages. Made once by AI, then reused for every customer.
model Translation {
  lang      String
  source    String
  text      String
  createdAt DateTime @default(now())

  @@id([lang, source])
}
